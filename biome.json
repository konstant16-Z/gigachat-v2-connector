{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/core/**",
      "src/gigachat/**",
      "src/streaming/**",
      "src/translation/**",
      "src/types/**",
      "tests/**",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "!dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
